# =============================================================
# Discord Gemini 社群聊天與跑團機器人 設定檔範本
# 複製此檔案並重新命名為 .env，填入您的專屬金鑰即可！
# =============================================================

# 1. Google Gemini API Key (於 Google AI Studio 免費取得，開頭通常為 AIzaSy...)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# 2. Discord 機器人 Token (於 Discord Developer Portal 的 Bot 分頁取得)
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# 3. 目標聊天頻道 ID (純數字，右鍵點擊 Discord 聊天文字頻道複製 ID)
# 填入後，機器人會在這個頻道內自動參與聊天、記待辦與主持跑團！
TARGET_CHANNEL_ID=1234567890123456789

# 4. 主要使用的 AI 模型 (預設 gemini-3.8-flash，速度極快且聰明)
PRIMARY_MODEL=gemini-3.8-flash

# 5. 是否關閉 Google 內容安全過濾 (預設 true：全面關閉審查，暢聊不被攔截拒答)
DISABLE_SAFETY_SETTINGS=true

# 6. 社群專屬提示詞檔案 (預設 general_prompt.txt)
GENERAL_PROMPT_FILE=general_prompt.txt

# 7. 獨立資料庫檔名 (預設 community.db)
DB_NAME=community.db
