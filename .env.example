# =============================================================
# Discord Gemini 日語共學 & 生活助理機器人 設定檔範本
# 💡 新手小提醒：前面有「# 」的行代表停用（註解），
#    若要啟用或修改某項設定，請記得把開頭的「# 」刪掉再存檔！
# =============================================================

# Discord Bot Token (從 Discord Developer Portal 取得)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Google Gemini API Key (從 Google AI Studio 取得)
GEMINI_API_KEY=your_gemini_api_key_here

# 頻道 1：日語教學綜合頻道 ID (你們和 AI 用中日文學習對話的地方，包含中文小卡)
TARGET_CHANNEL_ID=your_japanese_chat_channel_id_here

# 頻道 2：【可選】日語純文字同步紀錄頻道 ID (已內建 Edge-TTS 語音頻道朗讀，此欄可留空或作純文字紀錄)
TTS_CHANNEL_ID=your_tts_channel_id_here

# 頻道 3：【可選】一般日常三人群聊頻道 ID (純當好朋友隨意聊天、規劃行程、不刻意教日文)
GENERAL_CHANNEL_ID=your_general_chat_channel_id_here

# AI 模型輪替鏈設定：
# 全程僅使用 Flash-Lite 輕量系列，免費額度最充沛且不會誤觸高階/付費模型；
# 全部備援輪完若遇暫態限流，最後仍會回落 FINAL_FALLBACK_MODEL 保底重試。
PRIMARY_MODEL=gemini-flash-lite-latest
FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite
FINAL_FALLBACK_MODEL=gemini-flash-lite-latest

# 【可選】功能開關 (預設皆為 true；前面有「# 」代表停用註解，想自訂開關請刪除開頭的「# 」)
# ENABLE_JAPANESE_MODE=true
# ENABLE_FLASHCARD_MODE=true
# ENABLE_GAME_WIKI=true
# ENABLE_BOARD_GAMES=true
# ENABLE_VOICE_TTS=true
# ENABLE_SAFETY_GUARDRAIL=true
# DISABLE_SAFETY_SETTINGS=true
# DB_NAME=assistant.db

# 【可選】語音頻道 TTS 設定（內建免顯卡 Edge-TTS ＋ 選配本地 F5-TTS 伺服器）
TTS_API_URL=http://127.0.0.1:9880
TTS_API_TOKEN=
# F5_OFFLINE_FIRST=true          # 已下載過模型時優先直接讀本機 HF 快取，略過線上下載檢查
# F5_PRELOAD_ON_STARTUP=false    # 設為 true 會在啟動 F5-TTS 時背景預載模型進 VRAM（適合顯存充裕電腦）
# F5_IDLE_UNLOAD_SECONDS=1800    # 閒置幾秒後自動釋放 VRAM；設為 0 代表常駐顯存永不自動釋放（亦可用 !setup 或 !tts keepalive 即時切換）
TTS_DEFAULT_VOICE=edge:zh-TW-HsiaoChenNeural
TTS_JP_VOICE=edge:ja-JP-NanamiNeural
TTS_VOLUME_BOOST=1.25
TTS_MAX_CHARS=500
TTS_F5_MAX_CHARS=200
TTS_AI_AUTO_READ_JP=true
TTS_AI_AUTO_READ_GENERAL=false
# 是否開放成員上傳語音克隆（設為 true 後預設通過安檢即自動啟用）
ENABLE_USER_VOICE_CLONE=false
# auto=通過 FFmpeg 安檢立即啟用私人聲線＋通知擁有者備查；manual=需擁有者私訊一鍵審核
TTS_CLONE_APPROVAL_MODE=auto
TTS_CLONE_MAX_PER_USER=2
TTS_CLONE_MAX_TOTAL=40
TTS_CLONE_COOLDOWN_SECONDS=600
# 逗號分隔的機器人擁有者 Discord User ID（擁有 !models 模型檢視、F5-TTS 顯存釋放、審核克隆等最高權限）
BOT_OWNER_IDS=

# 【可選】多模態影音與 YouTube 分析安全閾值
# MAX_YOUTUBE_DURATION_SECONDS=180     # YouTube 影片時長上限（預設 180 秒 / 3 分鐘，防止 Token 爆量）
# MAX_VIDEO_ATTACHMENT_BYTES=20971520   # Discord 上傳短影片大小上限（預設 20 MB）
