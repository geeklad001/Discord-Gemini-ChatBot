# =============================================================
# 社群專屬 Discord Gemini Bot 設定檔範本 (含《殭屍學園》知識庫)
# 複製此檔案並命名為 .env.community，填入您的第二組金鑰即可！
# 💡 新手小提醒：前面有「# 」的行代表停用（註解），
#    若要啟用或修改某項設定，請記得把開頭的「# 」刪掉再存檔！
# =============================================================

# 1. 第二個 Google 帳號或專案的 Gemini API Key (額度完全獨立，享有全新每日免費 Quota)
GEMINI_API_KEY=YOUR_SECOND_GEMINI_API_KEY_HERE

# 2. 社群專用 Discord 機器人的 Bot Token (於 Discord Developer Portal 取得)
DISCORD_BOT_TOKEN=YOUR_COMMUNITY_DISCORD_BOT_TOKEN_HERE

# 3. 社群伺服器中的目標互動頻道 ID (純數字，右鍵點擊頻道名稱複製 ID)
TARGET_CHANNEL_ID=

# 4. 可選：社群專用的獨立第二頻道 (若不需要語音朗讀與多頻道，可留空)
TTS_CHANNEL_ID=
GENERAL_CHANNEL_ID=

# 5. 功能開關 (社群版預設關閉日語與單字卡，開啟《殭屍學園》知識庫與防白嫖護欄)
ENABLE_JAPANESE_MODE=false
ENABLE_FLASHCARD_MODE=false
ENABLE_GAME_WIKI=true
ENABLE_BOARD_GAMES=true
ENABLE_VOICE_TTS=true
ENABLE_SAFETY_GUARDRAIL=true
DISABLE_SAFETY_SETTINGS=true

# 6. 語音朗讀與多聲線設定 (未設定聲線者預設走 0 顯存 Edge-TTS，可選配共用本地 F5-TTS 公開聲線)
TTS_API_URL=http://127.0.0.1:9880
TTS_API_TOKEN=
# F5_OFFLINE_FIRST=true          # 優先直讀本機 Hugging Face 快取免連網檢查
# F5_PRELOAD_ON_STARTUP=false    # true=啟動時背景預載進顯存；可用 !tts keepalive on/off 即時調整
# F5_IDLE_UNLOAD_SECONDS=1800    # 0=常駐顯存不釋放；>0=閒置指定秒數後自動釋放 VRAM
TTS_DEFAULT_VOICE=edge:zh-TW-HsiaoChenNeural
TTS_AI_AUTO_READ_JP=false
TTS_AI_AUTO_READ_GENERAL=false
# 是否開放社群成員使用 !voiceclone 自助克隆（auto=通過安檢即啟用私人聲線，manual=需擁有者先審核）
ENABLE_USER_VOICE_CLONE=false
TTS_CLONE_APPROVAL_MODE=auto
TTS_CLONE_MAX_PER_USER=2
TTS_CLONE_MAX_TOTAL=40
TTS_CLONE_COOLDOWN_SECONDS=600
TTS_MAX_CHARS=500
TTS_F5_MAX_CHARS=200
# 逗號分隔的機器人擁有者 Discord User ID（僅擁有者可審核克隆、檢視 !models、釋放顯存與管理聲線；管理員可設定對象頻道）
BOT_OWNER_IDS=

# 7. 獨立資料庫檔名 (100% 資料隔離！)
DB_NAME=community.db

# 8. 實例顯示名稱 (顯示於後台 Log 與控制台)
BOT_INSTANCE_NAME=CommunityBot

# 9. AI 模型輪替鏈設定：
# 全程僅使用 Flash-Lite 輕量系列，免費額度最充沛且不會誤觸高階/付費模型；
# 全部備援輪完若遇暫態限流，最後仍會回落 FINAL_FALLBACK_MODEL 保底重試。
PRIMARY_MODEL=gemini-flash-lite-latest
FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite
FINAL_FALLBACK_MODEL=gemini-flash-lite-latest

# 10. 社群專屬提示詞檔案 (純繁中群聊、TRPG主持人、含遊戲知識庫規範)
GENERAL_PROMPT_FILE=general_prompt_community.txt
