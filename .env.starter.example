# =============================================================
# Discord Gemini 純淨社群版與跑團機器人 設定檔範本 (一鍵開箱專用)
# 雙擊 [1_設定金鑰_Setup_Env.bat] 會自動複製本檔為 .env！
# 💡 新手小提醒：前面有「# 」的行代表停用（註解），
#    若要啟用或修改某項設定，請記得把開頭的「# 」刪掉再存檔！
# =============================================================

# 1. Google Gemini API Key (於 Google AI Studio 免費取得，開頭通常為 AIzaSy...)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# 2. Discord 機器人 Token (於 Discord Developer Portal 的 Bot 分頁取得)
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# 3. 目標聊天頻道 ID (純數字，右鍵點擊 Discord 聊天文字頻道複製 ID)
TARGET_CHANNEL_ID=1234567890123456789

# 4. AI 模型輪替鏈設定：
# 以 Flash-Lite 輕量系列優先（最省免費額度），高峰遇 429 限流時自動備援切換至標準 Flash 與 Gemini 4 Hydrogen；
# 全部備援輪完若遇暫態限流，最後仍會回落 FINAL_FALLBACK_MODEL (Flash-Lite) 保底重試。
PRIMARY_MODEL=gemini-flash-lite-latest
FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite,gemini-flash-latest,gemini-3.8-flash,gemini-4-hydrogen,gemini-2.5-flash
FINAL_FALLBACK_MODEL=gemini-flash-lite-latest

# 5. 功能開關 (預設開啟純中文群聊 + 桌遊與80億分之1 + TRPG 跑團 + 語音朗讀 + 待辦/提醒/記憶；需要特定功能時改為 true 即可)
ENABLE_JAPANESE_MODE=false
ENABLE_FLASHCARD_MODE=false
ENABLE_GAME_WIKI=false
ENABLE_BOARD_GAMES=true
ENABLE_VOICE_TTS=true

# 語音朗讀預設為純 Edge-TTS（免顯卡、0 VRAM），若要啟用本地 F5-TTS 可填入 http://127.0.0.1:9880
TTS_API_URL=
TTS_API_TOKEN=
# F5_OFFLINE_FIRST=true
# F5_PRELOAD_ON_STARTUP=false
# F5_IDLE_UNLOAD_SECONDS=1800    # 0=常駐不釋放顯存；填寫 BOT_OWNER_IDS 後可用 !setup 面板免改檔案直接開關所有功能與選頻道！
TTS_DEFAULT_VOICE=edge:zh-TW-HsiaoChenNeural
ENABLE_USER_VOICE_CLONE=false
TTS_CLONE_APPROVAL_MODE=auto
TTS_CLONE_MAX_PER_USER=2
TTS_CLONE_MAX_TOTAL=40
TTS_CLONE_COOLDOWN_SECONDS=600
TTS_MAX_CHARS=500
TTS_F5_MAX_CHARS=200
# 【推薦填寫】填入你自己的 Discord 使用者 ID（右鍵自己的頭像 -> 複製使用者 ID），可解鎖 !reload、!models 等擁有者指令
BOT_OWNER_IDS=

# 6. 安全與防濫用設定
# - ENABLE_SAFETY_GUARDRAIL=false：關閉本地寫程式/作業防白嫖攔截，讓群友自由發問
# - DISABLE_SAFETY_SETTINGS=true：關閉 Google Gemini 內容安全審查，暢聊不被拒答
ENABLE_SAFETY_GUARDRAIL=false
DISABLE_SAFETY_SETTINGS=true

# 7. 社群專屬通用提示詞檔案 (可自行用記事本編輯修改個性)
GENERAL_PROMPT_FILE=general_prompt_starter.txt

# 8. 獨立資料庫檔名 & 實例顯示名稱
DB_NAME=community.db
BOT_INSTANCE_NAME=DiscordGeminiBot
